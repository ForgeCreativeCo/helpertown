# Copy this file to .env.local (git-ignored) and fill it in. Only the voice
# generation script reads it; nothing here ends up in the game.

# Which engine `npm run voices` uses: piper, elevenlabs or sapi.
VOICE_ENGINE=elevenlabs

# From elevenlabs.io → Developers → API Keys.
ELEVENLABS_API_KEY=

# Optional: a different voice than the default ("Bill"). `npm run voices -- --list-voices` prints ids.
ELEVENLABS_VOICE_ID=
